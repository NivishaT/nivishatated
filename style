* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
}

.container {
    width: 80%;
    margin: auto;
    overflow: hidden;
}

header {
    background: #333;
    color: #fff;
    padding-top: 30px;
    min-height: 70px;
    border-bottom: #77a9ff 3px solid;
}

header h1 {
    text-align: center;
    text-transform: uppercase;
    margin-bottom: 10px;
}

header p {
    text-align: center;
    font-size: 20px;
}

nav {
    background: #77a9ff;
    color: #fff;
    padding: 10px 0;
    overflow: hidden;
}

nav ul {
    padding: 0;
    list-style: none;
}

nav ul li {
    display: inline;
    margin: 0 5px;
}

nav ul li a {
    color: #fff;
    text-decoration: none;
    font-size: 18px;
}

section {
    padding: 20px 0;
}

section h2 {
    text-align: center;
    margin-bottom: 20px;
}

section p, section ul, section form {
    width: 60%;
    margin: auto;
}

section ul {
    list-style: none;
}

section ul li {
    background: #f4f4f4;
    margin: 5px 0;
    padding: 10px;
    text-align: center;
    border-radius: 5px;
}

.project {
    margin-bottom: 20px;
}

form label {
    display: block;
    margin: 10px 0 5px;
}

form input, form textarea {
    width: 100%;
    padding: 10px;
    margin-bottom: 10px;
}

form button {
    display: block;
    width: 100%;
    padding: 10px;
    background: #77a9ff;
    border: 0;
    color: #fff;
    font-size: 18px;
    cursor: pointer;
}

form button:hover {
    background: #555;
}

footer {
    background: #333;
    color: #fff;
    text-align: center;
    padding: 10px 0;
    margin-top: 20px;
}
